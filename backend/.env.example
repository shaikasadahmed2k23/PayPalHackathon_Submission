# PayPal sandbox REST app credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

DATABASE_URL=sqlite:///./leashpay.db

# gemini | groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# base64 32-byte Ed25519 seed; if empty, one is generated into backend/keys/
SERVER_SIGNING_KEY=
FRONTEND_URL=http://localhost:3000

# Sandbox business account email that receives ALL demo merchant payouts
MERCHANT_PAYOUT_EMAIL=
