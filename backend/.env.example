# PayPal sandbox REST app credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Local: sqlite. Supabase: paste the *Session pooler* URI (postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres)
# postgres:// and postgresql:// are both accepted. Never commit the real value.
DATABASE_URL=sqlite:///./leashpay.db

# gemini | groq
LLM_PROVIDER=gemini
# Used when the primary is rate limited (e.g. Gemini free tier = 5 req/min) or fails
LLM_FALLBACK=groq
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# base64 32-byte Ed25519 seed (python scripts/gen_signing_key.py).
# Local: if empty, one is generated into backend/keys/. APP_ENV=production: REQUIRED (server refuses to start without it).
SERVER_SIGNING_KEY=
FRONTEND_URL=http://localhost:3000
# development | production
APP_ENV=development
# Comma-separated browser origins allowed to call this API (the deployed web URL in production)
CORS_ORIGINS=http://localhost:3000

# Sandbox business account email that receives ALL demo merchant payouts
MERCHANT_PAYOUT_EMAIL=
